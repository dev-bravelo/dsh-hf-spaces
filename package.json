{
  "name": "dsh-hf-spaces",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "DeepSeek Harness plugin: use an LLM served from a GPU Hugging Face Space, started on demand and stopped when idle, with live progress, cost and balance in the Harness UI. Pre-alpha.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-bravelo/dsh-hf-spaces.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hugging-face",
    "huggingface-spaces",
    "llm",
    "llama.cpp",
    "openai-compatible"
  ],
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "docs",
    "examples",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-secrets.mjs && node --test test/*.test.mjs",
    "hooks": "git config core.hooksPath .githooks"
  }
}
